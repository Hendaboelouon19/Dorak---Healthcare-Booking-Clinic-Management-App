rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }

    function isAdmin() {
      return signedIn() && userRole(request.auth.uid) == 'admin';
    }

    function isAssistant() {
      return signedIn() && userRole(request.auth.uid) == 'assistant';
    }

    function isPatient() {
      return signedIn() && userRole(request.auth.uid) == 'patient';
    }

    match /users/{userId} {
      allow read: if signedIn() && (userId == request.auth.uid || isAdmin() || isAssistant());
      allow create: if signedIn() && userId == request.auth.uid;
      allow update: if signedIn() && (userId == request.auth.uid || isAdmin());
      allow delete: if signedIn() && isAdmin();
    }

    match /clinics/{clinicId} {
      allow read: if true;
      allow create, update, delete: if signedIn() && (isAdmin() || isAssistant());
    }

    match /clinics/{clinicId}/doctors/{doctorId} {
      allow read: if true;
      allow create, update, delete: if signedIn() && (isAdmin() || isAssistant());
    }

    match /clinics/{clinicId}/doctors/{doctorId}/slots/{slotId} {
      allow read: if true;
      allow create, update, delete: if signedIn() && (isAdmin() || isAssistant() || isPatient());
    }

    match /appointments/{appointmentId} {
      allow read: if signedIn() && (
        resource.data.patientId == request.auth.uid ||
        isAdmin() ||
        isAssistant()
      );

      allow create: if signedIn() &&
        request.resource.data.patientId == request.auth.uid &&
        request.resource.data.status == 'booked';

      allow update: if signedIn() && (
        resource.data.patientId == request.auth.uid ||
        isAdmin() ||
        isAssistant()
      );

      allow delete: if signedIn() && isAdmin();
    }

    match /notifications/{notificationId} {
      allow read, create, update, delete: if signedIn();
    }
  }
}
